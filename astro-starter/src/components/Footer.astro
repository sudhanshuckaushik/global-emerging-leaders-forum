---
import { site, LOGO_META } from "../data/site";
const { footer } = site;
---

<footer>
  <div class="container foot">
    <div class="foot-text">
      <p class="foot-address">{footer.address}</p>
      <p class="foot-edition">{footer.edition}</p>
    </div>
    <div class="foot-logos">
      {site.partners.map((p) => (
        <img src={LOGO_META[p].src} alt={LOGO_META[p].alt} height="24" loading="lazy" />
      ))}
    </div>
  </div>
  <p class="container foot-fine">© {new Date().getFullYear()} {site.name}. {footer.fine}</p>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding-block: 3.5rem 2.5rem; margin-top: 2rem; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; padding-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
  .foot-address { color: var(--text); font-family: var(--font-ui); font-weight: 600; }
  .foot-edition { color: var(--text-mute); font-size: 0.9rem; margin-top: 0.35rem; }
  .foot-logos { display: flex; align-items: center; gap: 1.75rem; }
  .foot-logos img { filter: brightness(0) invert(1); opacity: 0.7; width: auto; }
  .foot-fine { margin-top: 2.5rem; color: var(--text-mute); font-size: 0.72rem; letter-spacing: 0.04em; }
  @media (max-width: 640px) { .foot { flex-direction: column; align-items: flex-start; } }
</style>
