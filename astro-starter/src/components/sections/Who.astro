---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { who } = site;
---

<!-- Recipe C: 3-up rounded text cards, closed by a centered pill CTA -->
<section class="section container who" id="who">
  <SectionHeader eyebrow={who.tag} title={who.title} lead={who.lead} />
  <div class="grid12">
    {who.cards.map((c) => (
      <article class="card card-pad col-4 who-card reveal">
        <span class="who-icon">{c.icon}</span>
        <h3 class="who-title">{c.title}</h3>
        <p class="who-desc">{c.desc}</p>
        <p class="who-eg t-designation">{c.eg}</p>
      </article>
    ))}
  </div>
  <div class="cta-row reveal">
    <a class="cta-pill" href="/#nominate">Nominate a leader →</a>
  </div>
</section>

<style>
  .who-card { display: flex; flex-direction: column; gap: 0.6rem; transition: transform 0.25s var(--ease-brand); }
  .who-card:hover { transform: translateY(-4px); }
  .who-icon { font-size: 1.6rem; }
  .who-title { font-family: var(--font-ui); font-weight: 800; font-size: 1.25rem; color: var(--c-name); }
  .who-desc { color: var(--text-mute); font-size: 1rem; line-height: 1.65; flex: 1; }
  .who-eg { font-size: 0.6rem; line-height: 1.5; margin-top: 0.5rem; }
</style>
