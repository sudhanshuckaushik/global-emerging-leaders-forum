---
import GradientBackground from "../GradientBackground.astro";
import SectionHeader from "../SectionHeader.astro";
import { site, LOGO_META } from "../../data/site";
const { contact } = site;
const kp = contact.knowledgePartner;
const cv = contact.convener;
---

<section class="section contact" id="contact">
  <!-- WARM closing glow: amber-pink radial (#FFB533 → #FF63D2) -->
  <GradientBackground type="radial" color1="#FFB533" color2="#FF63D2" speed={2} scale={1.6} centerX={0} centerY={0.5} class="contact-bg" />
  <div class="container contact-inner">
    <div class="contact-text">
      <SectionHeader eyebrow={contact.tag} title={contact.title} />
      {contact.body.map((p) => <p class="reveal">{p}</p>)}
      <div class="contact-links reveal">
        {contact.links.map((l) => (
          <a class="clink" href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
            <span class="clink-icon">{l.icon}</span>
            <span>
              <span class="clink-label t-designation">{l.label}</span>
              <span class="clink-val">{l.val}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <aside class="contact-aside reveal">
      <div class="partner">
        <span class="t-designation">{kp.eyebrow}</span>
        <img class="partner-logo" src={LOGO_META[kp.logo].src} alt={LOGO_META[kp.logo].alt} height="30" />
        <p class="partner-text">{kp.text}</p>
        <span class="partner-tagline">{kp.tagline}</span>
      </div>
      <div class="partner">
        <img class="partner-logo" src={LOGO_META[cv.logo].src} alt={LOGO_META[cv.logo].alt} height="34" />
        <p class="partner-text">{cv.text}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .contact { position: relative; isolation: isolate; overflow: hidden; }
  .contact :global(.contact-bg) { opacity: 0.34; }
  .contact::after { content: ""; position: absolute; inset: 0; z-index: 1; background: radial-gradient(120% 100% at 0% 50%, rgba(7,7,15,0.7), rgba(7,7,15,0.94)); }
  .contact-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; }
  .contact-text p { color: var(--text-mute); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.25rem; max-width: 46ch; }
  .contact-links { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
  .clink { display: grid; grid-template-columns: 2.5rem 1fr; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--bg-elev); border: 1px solid var(--line); transition: border-color 0.2s var(--ease-brand); }
  .clink:hover { border-color: var(--c-designation); }
  .clink-icon { font-size: 1.25rem; }
  .clink-label { display: block; font-size: 0.58rem; margin-bottom: 0.15rem; }
  .clink-val { color: var(--text); font-family: var(--font-ui); }
  .contact-aside { display: flex; flex-direction: column; gap: 1.5rem; }
  .partner { padding: 1.75rem; background: rgba(7,7,15,0.5); border: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.85rem; }
  .partner .t-designation { font-size: 0.58rem; }
  .partner-logo { filter: brightness(0) invert(1); opacity: 0.9; align-self: flex-start; width: auto; }
  .partner-text { color: var(--text-mute); font-size: 0.92rem; line-height: 1.6; }
  .partner-tagline { font-family: var(--font-ui); font-weight: 600; font-style: italic; color: rgba(233,233,251,0.4); }
  @media (max-width: 860px) { .contact-inner { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
