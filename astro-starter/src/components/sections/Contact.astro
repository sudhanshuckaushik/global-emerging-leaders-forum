---
import SectionHeader from "../SectionHeader.astro";
import { site, LOGO_META } from "../../data/site";
const { contact } = site;
const kp = contact.knowledgePartner;
const cv = contact.convener;
---

<!-- Quiet closer (8+4): text + link cards, partner cards aside. No gradient —
     the page goes silent after the Nominate panel, per the card-system pacing. -->
<section class="section container contact" id="contact">
  <div class="grid12">
    <div class="card card-pad col-8 contact-text reveal">
      <SectionHeader eyebrow={contact.tag} title={contact.title} align="start" />
      {contact.body.map((p) => <p>{p}</p>)}
      <div class="contact-links">
        {contact.links.map((l) => (
          <a class="clink" href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
            <span class="clink-icon">{l.icon}</span>
            <span>
              <span class="clink-label t-designation">{l.label}</span>
              <span class="clink-val">{l.val}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <aside class="col-4 contact-aside reveal">
      <div class="card card-pad partner">
        <span class="t-designation">{kp.eyebrow}</span>
        <img class="partner-logo" src={LOGO_META[kp.logo].src} alt={LOGO_META[kp.logo].alt} height="30" />
        <p class="partner-text">{kp.text}</p>
        <span class="partner-tagline">{kp.tagline}</span>
      </div>
      <div class="card card-pad partner">
        <img class="partner-logo" src={LOGO_META[cv.logo].src} alt={LOGO_META[cv.logo].alt} height="34" />
        <p class="partner-text">{cv.text}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .contact-text :global(.sh) { margin-bottom: 1.5rem; }
  .contact-text p { color: var(--text-mute); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.25rem; max-width: 56ch; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
  .clink {
    display: grid; grid-template-columns: 2.5rem 1fr; align-items: center; gap: 0.75rem;
    padding: 1rem 1.5rem 1rem 1.25rem; background: var(--bg); border: 1px solid var(--line);
    border-radius: 999px; transition: border-color 0.2s var(--ease-brand);
  }
  .clink:hover { border-color: var(--c-designation); }
  .clink-icon { font-size: 1.25rem; }
  .clink-label { display: block; font-size: 0.58rem; margin-bottom: 0.15rem; }
  .clink-val { color: var(--text); font-family: var(--font-ui); }
  .contact-aside { display: flex; flex-direction: column; gap: var(--gutter); }
  .partner { display: flex; flex-direction: column; gap: 0.85rem; flex: 1; }
  .partner .t-designation { font-size: 0.58rem; }
  .partner-logo { filter: brightness(0) invert(1); opacity: 0.9; align-self: flex-start; width: auto; }
  .partner-text { color: var(--text-mute); font-size: 0.92rem; line-height: 1.6; }
  .partner-tagline { font-family: var(--font-ui); font-weight: 600; font-style: italic; color: rgba(233,233,251,0.4); }
</style>
