---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { location } = site;
---

<!-- Two 6-col rounded cards; the badge field becomes an inline pill -->
<section class="section container location" id="location">
  <SectionHeader eyebrow={location.tag} title={location.title} lead={location.lead} />
  <div class="grid12">
    {location.cards.map((c) => (
      <article class={`card card-pad col-6 loc-card reveal accent-${c.accent}`}>
        <span class="pill loc-pill">{c.badge}</span>
        <h3 class="loc-name">{c.name}</h3>
        <p class="loc-text">{c.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .loc-card { display: flex; flex-direction: column; align-items: flex-start; }
  .loc-pill { --pill-bg: rgba(0, 229, 255, 0.14); color: var(--c-designation); font-size: 0.58rem; }
  .accent-amber .loc-pill { --pill-bg: rgba(255, 181, 27, 0.16); color: #ffb51b; }
  .loc-name { font-family: var(--font-ui); font-weight: 800; font-size: 1.2rem; color: var(--c-name); margin: 0.9rem 0 0.5rem; }
  .loc-text { color: var(--text-mute); font-size: 0.98rem; line-height: 1.6; }
</style>
