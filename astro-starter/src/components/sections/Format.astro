---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { format } = site;
---

<!-- Recipe B (8+4): wide day-by-day card + narrow principles card -->
<section class="section container format" id="format">
  <SectionHeader eyebrow={format.tag} title={format.title} lead={format.lead} />
  <div class="grid12">
    <ol class="card card-pad col-8 days reveal">
      {format.days.map((d) => (
        <li class="day">
          <span class="pill day-pill">{d.label}</span>
          <div class="day-content">
            <h3 class="day-theme">{d.theme}</h3>
            <p class="day-text" set:html={d.text} />
          </div>
        </li>
      ))}
    </ol>
    <div class="card card-pad col-4 principles reveal">
      {format.principles.map((p) => (
        <div class="principle">
          <span class="p-icon">{p.icon}</span>
          <div>
            <h4 class="p-title">{p.title}</h4>
            <p class="p-text">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .days { list-style: none; display: flex; flex-direction: column; justify-content: space-between; }
  .day { display: grid; grid-template-columns: 4rem 1fr; gap: 1.25rem; padding: 1.4rem 0; border-top: 1px solid var(--line); align-items: start; }
  .day:first-child { border-top: none; padding-top: 0; }
  .day:last-child { padding-bottom: 0; }
  .day-pill { --pill-bg: rgba(0, 229, 255, 0.14); color: var(--c-designation); font-size: 0.58rem; padding: 0.3rem 0.7rem; }
  .day-theme { font-family: var(--font-ui); font-weight: 800; font-size: 1.15rem; color: var(--c-name); margin-bottom: 0.35rem; }
  .day-text { color: var(--text-mute); font-size: 0.95rem; line-height: 1.6; }
  .day-text :global(em) { color: var(--c-designation); font-style: italic; }
  .principles { display: flex; flex-direction: column; gap: 1.5rem; }
  .principle { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; }
  .p-icon { font-size: 1.25rem; }
  .p-title { font-family: var(--font-ui); font-weight: 800; font-size: 1rem; color: var(--text); margin-bottom: 0.3rem; }
  .p-text { color: var(--text-mute); font-size: 0.92rem; line-height: 1.55; }
</style>
