---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { format } = site;
---

<section class="section container format" id="format">
  <SectionHeader eyebrow={format.tag} title={format.title} lead={format.lead} />
  <div class="format-grid">
    <ol class="days">
      {format.days.map((d) => (
        <li class="day reveal">
          <span class="day-label t-designation">{d.label}</span>
          <div class="day-content">
            <h3 class="day-theme">{d.theme}</h3>
            <p class="day-text" set:html={d.text} />
          </div>
        </li>
      ))}
    </ol>
    <div class="principles">
      {format.principles.map((p) => (
        <div class="principle reveal">
          <span class="p-icon">{p.icon}</span>
          <div>
            <h4 class="p-title">{p.title}</h4>
            <p class="p-text">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .format-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-top: 1rem; }
  .days { list-style: none; }
  .day { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.25rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .day:last-child { border-bottom: 1px solid var(--line); }
  .day-label { font-size: 0.72rem; padding-top: 0.3rem; }
  .day-theme { font-family: var(--font-ui); font-weight: 800; font-size: 1.15rem; color: var(--c-name); margin-bottom: 0.35rem; }
  .day-text { color: var(--text-mute); font-size: 0.95rem; line-height: 1.6; }
  .day-text :global(em) { color: var(--c-designation); font-style: italic; }
  .principles { display: flex; flex-direction: column; gap: 1.25rem; }
  .principle { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 1.25rem; background: var(--bg-elev); border-left: 2px solid var(--c-designation); }
  .p-icon { font-size: 1.25rem; }
  .p-title { font-family: var(--font-ui); font-weight: 800; font-size: 1rem; color: var(--text); margin-bottom: 0.3rem; }
  .p-text { color: var(--text-mute); font-size: 0.92rem; line-height: 1.55; }
  @media (max-width: 860px) { .format-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
