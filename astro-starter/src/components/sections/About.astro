---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { about } = site;
---

<!-- Recipe B (8+4): wide text card + narrow column of quote cards -->
<section class="section container about" id="about">
  <div class="grid12">
    <div class="card card-pad col-8 about-body reveal">
      <SectionHeader eyebrow={about.tag} title={about.title} align="start" />
      {about.body.map((p) => <p>{p}</p>)}
      <div class="tags">
        {about.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </div>
    <aside class="col-4 about-aside">
      {about.asides.map((a, i) => (
        <blockquote class={`card card-pad quote quote-${a.tone} reveal`} style={`--d:${i * 0.1}s`}>
          <p>{a.quote}</p>
          <cite>{a.attr}</cite>
        </blockquote>
      ))}
    </aside>
  </div>
</section>

<style>
  .about-body :global(.sh) { margin-bottom: 1.75rem; }
  .about-body p { color: var(--text-mute); font-size: 1.08rem; line-height: 1.85; margin-bottom: 1.25rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .tag {
    font-family: var(--font-ui); font-weight: 600; font-size: 0.62rem; letter-spacing: 0.1em;
    text-transform: uppercase; padding: 0.4rem 0.85rem; border: 1px solid var(--line);
    border-radius: 999px; color: var(--c-designation);
  }
  .about-aside { display: flex; flex-direction: column; gap: var(--gutter); }
  .quote { flex: 1; display: flex; flex-direction: column; justify-content: center; transition-delay: var(--d); }
  .quote p { font-family: var(--font-ui); font-weight: 600; font-size: 1.1rem; line-height: 1.5; }
  .quote-blue { background: linear-gradient(135deg, rgba(1,55,255,0.22), var(--bg-elev)); }
  .quote-blue p { color: var(--c-name); }
  .quote-pale p { color: var(--text); }
  .quote cite { display: block; margin-top: 1rem; font-family: var(--font-ui); font-style: normal; font-size: 0.68rem; letter-spacing: 0.08em; color: var(--text-mute); }
</style>
