---
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { outcomes } = site;
---

<!-- Recipe C: 3-up × 2 numbered cards (the page stays quiet between panels) -->
<section class="section container outcomes" id="outcomes">
  <SectionHeader eyebrow={outcomes.tag} title={outcomes.title} lead={outcomes.lead} />
  <div class="grid12">
    {outcomes.items.map((o, i) => (
      <article class="card card-pad col-4 out reveal">
        <span class="out-num t-designation">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="out-title">{o.title}</h3>
        <p class="out-text">{o.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .out { display: flex; flex-direction: column; gap: 0.6rem; transition: transform 0.25s var(--ease-brand); }
  .out:hover { transform: translateY(-4px); }
  .out-num { font-size: 0.66rem; opacity: 0.7; }
  .out-title { font-family: var(--font-ui); font-weight: 800; font-size: 1.15rem; color: var(--c-name); }
  .out-text { color: var(--text-mute); font-size: 0.95rem; line-height: 1.6; }
</style>
