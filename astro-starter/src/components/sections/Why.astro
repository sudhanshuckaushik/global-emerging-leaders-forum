---
import SectionHeader from "../SectionHeader.astro";
import DuotoneImage from "../DuotoneImage.astro";
import { site } from "../../data/site";
const { why } = site;
---

<!-- Recipe B flipped (4+8): portrait photo card + wide text card, then 3-up stats -->
<section class="section container why" id="why">
  <div class="grid12">
    <div class="col-4 why-photo card reveal">
      <DuotoneImage name={why.heroPhoto.name} alt={why.heroPhoto.alt} class="why-img" sizes="(max-width:860px) 100vw, 33vw" />
    </div>
    <div class="card card-pad col-8 why-body reveal">
      <SectionHeader eyebrow={why.tag} title={why.title} align="start" />
      {why.body.slice(0, 2).map((p) => <p>{p}</p>)}
      <p class="pull">{why.pull}</p>
      {why.body.slice(2).map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="grid12 why-stats">
    {why.stats.map((s) => (
      <div class="card card-pad col-4 stat reveal">
        <div class="stat-num t-name">{s.num}</div>
        <div class="stat-label t-designation">{s.label}</div>
        <p class="stat-note">{s.note}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .why-photo { min-height: 420px; }
  /* Fill the card: DuotoneImage's figure needs explicit height to cover */
  .why-photo :global(.why-img) { position: absolute; inset: 0; }
  .why-body :global(.sh) { margin-bottom: 1.5rem; }
  .why-body p { color: var(--text-mute); font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.15rem; }
  .pull {
    font-family: var(--font-ui); font-weight: 700; color: var(--c-name);
    font-size: 1.35rem; line-height: 1.45; margin: 1.5rem 0;
  }
  .why-stats { margin-top: var(--gutter); }
  .stat-num { font-size: 2.6rem; line-height: 1; }
  .stat-label { font-size: 0.66rem; margin: 0.6rem 0 0.5rem; }
  .stat-note { color: var(--text-mute); font-size: 0.9rem; line-height: 1.55; }
  @media (max-width: 860px) { .why-photo { min-height: 320px; } }
</style>
