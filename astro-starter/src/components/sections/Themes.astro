---
import GradientBackground from "../GradientBackground.astro";
import SectionHeader from "../SectionHeader.astro";
import { site } from "../../data/site";
const { themes } = site;
---

<!-- Recipe D: full-width color panel #1 — the warm mid-page chapter break -->
<section class="section container themes" id="themes">
  <div class="panel themes-panel reveal">
    <GradientBackground type="linear" color1="#660036" color2="#FF3A33" speed={3} scale={1.8} angle={90} class="themes-bg" />
    <div class="themes-inner">
      <SectionHeader eyebrow={themes.tag} title={themes.title} lead={themes.lead} />
      <div class="themes-grid">
        {themes.items.map((t) => (
          <article class="theme reveal">
            <h3 class="theme-title">{t.title}</h3>
            <p class="theme-body">{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Full-colour shader — no scrim; the translucent cards carry legibility */
  .themes-inner { position: relative; z-index: 2; padding: clamp(2.5rem, 5vw, 4rem); }
  .themes-inner :global(.lead) { color: rgba(255,255,255,0.75); }
  .themes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .theme {
    background: rgba(7,7,15,0.5); backdrop-filter: blur(4px);
    border-radius: var(--radius-card); padding: 1.9rem 1.6rem;
    display: flex; flex-direction: column; gap: 0.75rem;
    transition: background 0.25s var(--ease-brand);
  }
  .theme:hover { background: rgba(7,7,15,0.3); }
  .theme-title { font-family: var(--font-ui); font-weight: 800; font-size: 1.2rem; color: #fff; line-height: 1.2; }
  .theme-body { color: rgba(255,255,255,0.72); font-size: 0.98rem; line-height: 1.6; }
  @media (max-width: 820px) { .themes-grid { grid-template-columns: 1fr; } }
</style>
