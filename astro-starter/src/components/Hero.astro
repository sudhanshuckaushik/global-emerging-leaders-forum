---
import GradientBackground from "./GradientBackground.astro";
import { site, LOGO_META } from "../data/site";
const { hero } = site;
---

<header class="hero">
  <!-- Signature: animated brand shader (cool blue radial, preset-4) -->
  <GradientBackground type="radial" color1="#B9C3FE" color2="#0137FF" speed={2} scale={1.9} centerY={0} />

  <div class="hero-top container">
    <div class="hero-logos">
      {site.partners.map((p) => (
        <img class="hero-logo" src={LOGO_META[p].src} alt={LOGO_META[p].alt} height="26" loading="eager" />
      ))}
    </div>
    <span class="hero-pill t-designation">{hero.pill}</span>
  </div>

  <div class="hero-inner container">
    <p class="t-forum reveal">{hero.lockup}</p>
    <h1 class="t-headline reveal">{hero.title}</h1>
    <p class="hero-desc reveal">{hero.description}</p>

    <div class="hero-meta reveal">
      {hero.meta.map((m) => (
        <div class="meta-item">
          <span class="meta-val t-name">{m.value}</span>
          <span class="meta-key t-designation">{m.key}</span>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; padding-block: 8rem 5rem; overflow: hidden; isolation: isolate; }
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(7,7,15,0.94) 0%, rgba(7,7,15,0.4) 45%, rgba(7,7,15,0.15) 100%); }

  .hero-top { position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 3; padding-top: 5.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .hero-logos { display: flex; align-items: center; gap: 1.75rem; opacity: 0; animation: fade 1s 0.2s forwards; }
  .hero-logo { height: 26px; width: auto; filter: brightness(0) invert(1); opacity: 0.85; }
  .hero-pill { font-size: 0.6rem; border: 1px solid rgba(0,229,255,0.4); padding: 0.4rem 0.9rem; opacity: 0; animation: fade 1s 0.35s forwards; }
  @keyframes fade { to { opacity: 1; } }

  .hero-inner { position: relative; z-index: 2; }
  .hero .t-forum { font-size: clamp(0.85rem, 1.4vw, 1.05rem); margin-bottom: 1.5rem; }
  .hero .t-headline { font-size: clamp(3rem, 9vw, 8rem); max-width: 15ch; margin-bottom: 1.25rem; }
  .hero-desc { font-family: var(--font-ui); color: var(--text); font-size: clamp(1rem, 1.6vw, 1.25rem); max-width: 48ch; margin-top: 1.5rem; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 3rem; margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .meta-item { display: flex; flex-direction: column; gap: 0.4rem; }
  .meta-val { font-size: 2rem; line-height: 1; }
  .meta-key { font-size: 0.6rem; letter-spacing: 0.15em; }
  @media (max-width: 640px) { .hero-logos { gap: 1rem; } .hero-logo { height: 20px; } }
</style>
