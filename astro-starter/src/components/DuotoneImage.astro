---
import { Image } from "astro:assets";
import { photo } from "../lib/photos";

/**
 * DuotoneImage — the brand-kit SACRED rule made reusable: photos never appear
 * in raw color. Astro <Image> optimizes (responsive WebP, lazy), then the
 * `#duotone-cyan` SVG filter (defined once in BaseLayout) maps luminance onto
 * the derived cyan map (#68EBED highlights → #042E2F shadows).
 */
interface Props {
  name: string;         // photo key, e.g. "photo-89cf5da0"
  alt: string;
  class?: string;
  sizes?: string;
  loading?: "lazy" | "eager";
}
const { name, alt, class: cls = "", sizes = "(max-width: 800px) 100vw, 45vw", loading = "lazy" } = Astro.props;
---

<figure class={`duotone ${cls}`}>
  <Image src={photo(name)} alt={alt} widths={[480, 900, 1400]} sizes={sizes} loading={loading} />
</figure>

<style>
  .duotone { position: relative; margin: 0; overflow: hidden; background: var(--duotone-dark); }
  .duotone :global(img) {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: url(#duotone-cyan);
    transition: transform 0.9s var(--ease-brand), filter 0.4s var(--ease-brand);
  }
  /* Reveal a hint of true color on hover — the image "warms up" on attention */
  .duotone:hover :global(img) { filter: url(#duotone-cyan) saturate(1.1); transform: scale(1.04); }
  /* Cyan edge-glow ties photos to the palette */
  .duotone::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(104, 235, 237, 0.22);
    mix-blend-mode: screen;
  }
</style>
