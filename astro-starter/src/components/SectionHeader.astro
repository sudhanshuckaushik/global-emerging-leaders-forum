---
/**
 * SectionHeader — the shared eyebrow + title lockup.
 * Default (center): BM-style chapter header — uppercase display title flanked
 * by ● dots in forum red, eyebrow above, optional lead below.
 * `align="start"`: compact left variant for use INSIDE wide text cards (no dots).
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "start" | "center";
}
const { eyebrow, title, lead, align = "center" } = Astro.props;
---

<header class={`sh sh-${align}`}>
  <p class="t-designation eyebrow reveal">{eyebrow}</p>
  <h2 class="t-headline title reveal">
    {align === "center" && <span class="dot" aria-hidden="true">●</span>}
    <span>{title}</span>
    {align === "center" && <span class="dot" aria-hidden="true">●</span>}
  </h2>
  {lead && <p class="lead reveal">{lead}</p>}
</header>

<style>
  .sh { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2.5rem; }
  .sh-center { align-items: center; text-align: center; }
  .sh-start { align-items: flex-start; text-align: left; }
  .eyebrow { font-size: 0.62rem; }
  .title { font-size: clamp(1.9rem, 4.5vw, 3.4rem); }
  .sh-start .title { max-width: 20ch; }
  .sh-center .title { max-width: 28ch; }
  /* Dots flow inline with the text so multi-line titles keep them attached
     to the first/last word instead of wrapping onto their own line. */
  .dot {
    display: inline-block; color: var(--c-forum); font-size: 0.38em;
    line-height: 1; vertical-align: middle;
  }
  .sh-center .dot:first-child { margin-right: 1.2em; }
  .sh-center .dot:last-child { margin-left: 1.2em; }
  .lead {
    font-family: var(--font-ui); color: var(--text-mute);
    font-size: clamp(1.02rem, 1.6vw, 1.25rem); max-width: 62ch; margin-top: 0.5rem;
  }
  .sh-center .lead { margin-inline: auto; }
</style>
